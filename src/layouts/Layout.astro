---
import "../styles/global.css";
import studioLogoSmall from "../assets/Dark BG_Logo.png";
import studioLogoBanner from "../assets/Dark BG_Name_Website Header.png";

const {
	pageTitle = "Rental Home Design Studio",
	pageDescription = "After Dark Studio helps renters in Hong Kong create homes they enjoy coming back to.",
	headerTheme = "light",
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<title>{pageTitle}</title>
	</head>
	<body class="site-body">
		<header class={`site-header site-header--${headerTheme}`}>
			<div class="site-shell site-header__inner">
				<a class="brand" href="/" aria-label="Home">
					<img class="brand__mark brand__mark--mobile" src={studioLogoSmall.src} alt="After Dark Studio logo" width="48" height="48" />
					<img class="brand__mark brand__mark--desktop" src={studioLogoBanner.src} alt="After Dark Studio" />
				</a>

				<nav class="site-nav" aria-label="Primary">
				<a href="/blog">Blog</a>
				<!-- <a href="/projects">Projects</a> -->
				</nav>

				<a href="#ready" class="header-cta">Contact</a>
			</div>
		</header>

		<main class="site-main">
			<slot />
		</main>

		<!-- Removed 'First step and contact' section per copy refinement request -->

		<footer class="site-footer">
			<div class="site-shell site-footer__inner">
				<nav class="site-footer__nav">
					<a href="/">Home</a>
					<a href="/projects">Projects</a>
					<a href="/blog">Blog</a>
					<a href="#ready">Enquiry form</a>
				</nav>
				<p>© {new Date().getFullYear()} After Dark Studio — All rights reserved.</p>
			</div>
		</footer>
	</body>
</html>
<style>
.site-nav {
  display: flex;
  align-items: center;
}

.site-nav a:first-child {
  margin-left: auto;
}
	</style>