---
import heroImageLaptop from "../assets/NYC home editted_2.jpg";
import heroImageMobile from "../assets/NYC home editted_4.jpg";
---

<section class="hero-compact" aria-label="Hero">
  <img class="hero-bg-image hero-bg-image--laptop" src={heroImageLaptop.src} alt="A small rental bedroom where sleeping, working, and storage coexist within a single spatial system organised around daily routines" />
  <img class="hero-bg-image hero-bg-image--mobile" src={heroImageMobile.src} alt="A small rental bedroom where sleeping, working, and storage coexist within a single spatial system organised around daily routines" />
  <div class="hero-content">
    <h1 class="hero-heading">
      Your home should fit you,<br />not the other way around.
    </h1>
     <p class="hero-tag"><strong>Because even a one-year rental deserves a real home.</strong></p>
    <p>A focused, two-session service that <strong>helps renters create homes they enjoy coming back to</strong>, using mostly what they already have and without starting over.</p>

    <div class="hero-actions">
      <a class="btn-primary" href="#ready">Book a free 15-minute Home Fit Call</a>
      <p class="hero-secondary">Not ready for a call? WhatsApp me 3 photos: <a href="https://wa.me/85254603454">+852 5460 3454</a></p>
    </div>
  </div>
</section>

<style>
  @font-face {
    font-family: "Calistro MT";
    src: url("/fonts/calistro-mt.ttf") format("truetype");
  }

  @font-face {
    font-family: "Ebrima";
    src: url("/fonts/ebrima.ttf") format("truetype");
  }

  .hero-compact {
    --section-bg: var(--bg);
    --section-heading: var(--heading);
    --section-text: var(--text);
    --section-accent: var(--accent-tan);
    --section-accent-text: var(--bg);
    --section-accent-hover: var(--accent-teal);
    --section-accent-link: var(--accent-teal);
    color: var(--section-text, var(--text));
    padding: 4rem 0 5rem;
    position: relative;
    overflow: visible;
  }

  .hero-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-bg-image--laptop {
    display: none;
  }

  .hero-bg-image--mobile {
    display: block;
  }

  @media (min-width: 861px) {
    .hero-bg-image--laptop {
      display: block;
    }

    .hero-bg-image--mobile {
      display: none;
    }
  }

  .hero-compact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  @media (min-width: 861px) {
    .hero-content {
      padding: 0 2rem;
    }
  }

  .hero-heading {
    margin: 0 auto;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.1;
    color: #f5f0e8;
    max-width: 56ch;
    text-align: center;
  }

  .hero-after-dark,
  .hero-studio {
    display: none;
  }

  .hero-compact p {
    margin: 0.75rem auto 0;
    color: #f5f0e8;
    max-width: 56ch;
    text-align: center;
  }

  .hero-tag {
    margin-top: 0.6rem;
    color: #f5f0e8;
    text-align: center;
  }

  .hero-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    background: var(--section-accent, var(--accent-tan));
    color: var(--section-accent-text, var(--bg));
    border-radius: 999px;
    font-weight: 600;
  }

  .btn-primary:hover {
    border: 2px solid var(--section-accent-hover, var(--accent-teal));
    padding: 0.68rem 1.48rem;
  }

  .hero-secondary {
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }

  .hero-secondary a { color: var(--section-accent-link, var(--accent-teal)); }

  @media (max-width: 720px) {
    .hero-compact {
      padding-bottom: 2.25rem;
      padding-top: 3rem;
    }

    .hero-content {
      text-align: center;
      padding: 0 1.5rem;
    }

    .btn-primary {
      display: block;
      width: 100%;
      text-align: center;
    }
  }
</style>
