---
const { id, title } = Astro.props;

---

<section
	id={id}
	class:list={[
		"section",
		id === "results" && "section--wide"
	]}
>  {title && <h2>{title}</h2>}
  <div class="section__inner">
    <slot />
  </div>
</section>

<style>
  .section {
    margin: 0;
    padding: 1rem 0;
    background: var(--section-bg, var(--bg));
    color: var(--section-text, var(--text));
    border-bottom: 2px solid var(--section-border, rgba(199, 148, 92, 0.2));
  }

  .section#investment,
  .section#ready {
    border-top: 2px solid var(--section-border, rgba(199, 148, 92, 0.2));
  }

  .section#investment {
    border-bottom: 2px solid var(--section-border, rgba(199, 148, 92, 0.2));
  }

  .section#ready {
    border-bottom: none;
  }

  .section__inner {
    max-width: 90ch;
    margin: 0 auto;
    display: block;
    gap: 1rem;
  }

  .section--wide .section__inner {
    max-width: 90rem;
    padding: 0 2rem;
  }

  .section__inner > .what-i-do__container {
    max-width: 100%;
    margin: 0;
  }

  .section > h2 {
    width: min(100%, var(--section-title-width, 100%));
    margin: 0 auto 0.75rem;
    padding-left: var(--section-title-offset, 0);
    box-sizing: border-box;
    color: var(--section-heading, var(--heading));
    font-size: clamp(2rem, 2.2vw, 1.5rem);
    text-align: var(--section-title-align, center);
  }

  .section :is(.button) {
    padding: 0.75rem 1rem;
    font-size: 1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

    @media (max-width: 720px) {
    .section__inner {
      padding: 0 1rem;
    }

    .section > h2 {
      font-family: var(--font-heading);
      font-size: clamp(1.5rem, 6vw, 1.75rem);
      line-height: 1.15;
      letter-spacing: 0.02em;
      color: var(--section-heading, var(--heading));
      text-align: center;
      width: calc(100% - 2rem);
      margin: 0 auto 1rem;
      padding-left: 0;
      padding-right: 0;
      box-sizing: border-box;
    }

    .section :is(.button) {
      width: auto;
    }
  }

</style>
