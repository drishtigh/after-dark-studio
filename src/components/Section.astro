---
const { id, title } = Astro.props;

---

<section id={id} class="section">
  {title && <h2>{title}</h2>}
  <div class="section__inner">
    <slot />
  </div>
</section>

<style>
  .section {
    margin: 0;
    padding: 1rem 0;
    background: var(--section-bg, var(--bg));
    color: var(--section-text, var(--text));
    border-bottom: 2px solid var(--section-border, rgba(199, 148, 92, 0.2));
  }

  .section#investment,
  .section#ready {
    border-top: 2px solid var(--section-border, rgba(199, 148, 92, 0.2));
  }

  .section#investment {
    border-bottom: 2px solid var(--section-border, rgba(199, 148, 92, 0.2));
  }

  .section#ready {
    border-bottom: none;
  }

  .section__inner {
    max-width: 68ch;
    margin: 0 auto;
    display: block;
    gap: 1rem;
  }

  .section__inner > .what-i-do__container {
    max-width: 100%;
    margin: 0;
  }

  .section > h2 {
    margin-bottom: 0.75rem;
    color: var(--section-heading, var(--heading));
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
  }

  .section :is(.button) {
    padding: 0.75rem 1rem;
    font-size: 1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 720px) {
    .section__inner { padding: 0 1rem; }
    .section :is(.button) { width: auto; }
  }
</style>
