---
const {
  src,
  alt = "",
  caption,
  layout = "inline" // inline | full | hero
} = Astro.props;
---

<figure class={`blog-image blog-image--${layout}`}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />

  {caption && (
    <figcaption class="caption">
      {caption}
    </figcaption>
  )}
</figure>

<style>
/* BASE */
.blog-image {
  margin: 2.5rem auto;
}

.blog-image img {
  width: 100%;
  display: block;
}

/* INLINE (body content images) */
.blog-image--inline {
  max-width: 720px;
  padding: 0 1.25rem;
}

.blog-image--inline img {
  border-radius: 12px;
}

/* FULL (edge-to-edge but NOT full viewport takeover) */
.blog-image--full {
  width: 100%;
  max-width: 1100px;
  padding: 0 1.25rem;
}

.blog-image--full img {
  border-radius: 12px;
}

/* HERO (framed “opening scene”, not billboard) */
.blog-image--hero {
  width: 100%;
  max-width: 1100px;
  padding: 0 1.25rem;
  margin: 0 auto 3.5rem;
}

.blog-image--hero img {
  height: clamp(260px, 55vh, 520px);
  object-fit: cover;
  border-radius: 14px;
}

/* CAPTION */
.caption {
  max-width: 65ch;
  margin: 0.75rem auto 0;
  font-size: 0.9rem;
  opacity: 0.7;
  font-style: italic;
  padding: 0 0.25rem;
}

/* SPACING CONTROL (clean separation between modes) */
.blog-post :global(.blog-image--hero) {
  margin-top: 0;
  margin-bottom: 3.5rem;
}

.blog-post :global(.blog-image--full) {
  margin: 3.5rem auto;
}

.blog-post :global(.blog-image--inline) {
  margin: 2.5rem auto;
}

/* MOBILE */
@media (max-width: 768px) {
  .blog-image--hero img {
    height: 42vh;
    border-radius: 12px;
  }

  .blog-image--inline,
  .blog-image--full,
  .blog-image--hero {
    padding: 0 1rem;
  }
}
</style>