---
---

<section id="process" class="section how-it-works">
  <div class="site-shell">
    <div class="how-it-works__inner">
      <div class="how-it-works__intro">
        <h2>How It Works</h2>
        <p class="subheading">A focused, two-session process. No renovations, no endless revisions.</p>
        <p class="intro">
          I work with a small number of clients each month, so this is a hands-on,
          collaborative process, not a quick moodboard.
        </p>
      </div>

      <div class="steps-wrapper">
        <div class="steps" role="list">
        <div class="step" role="listitem">
          <div class="step__circle">
            <span class="step__circle-text">Free Call</span>
          </div>
          <button class="step__toggle" aria-expanded="false">
            <h3>Free 15 minute Home Fit Call</h3>
          </button>
          <div class="step__content">
            <ul>
              <li>Talk about your space, what's not working, and what you'd like instead</li>
              <li>Ask about your routines and your budget comfort zone</li>
              <li>If it sounds like a good match, choose a package and book Session 1</li>
            </ul>
          </div>
        </div>

        <div class="step" role="listitem">
          <div class="step__circle">
            <span class="step__circle-text">Session 1</span>
          </div>
          <button class="step__toggle" aria-expanded="false">
            <h3>Session 1: Layout & Flow (90-120 min)</h3>
          </button>
          <div class="step__content">
            <ul>
              <li>Walk-through of your space and how you actually live in it</li>
              <li>Spot friction: where clutter gathers, what's hard to clean, what feels "off"</li>
              <li>Live rearranging to test new layouts and paths</li>
              <li>Small, focused shopping list only if we find real gaps (e.g. lighting, storage)</li>
            </ul>
          </div>
        </div>

        <div class="step" role="listitem">
          <div class="step__circle">
            <span class="step__circle-text">Session 2</span>
          </div>
            <button class="step__toggle" aria-expanded="false">
              <h3>Session 2: Setup & Tuning (60-90 min)</h3>
            </button>
            <div class="step__content">
              <ul>
                <li>Put furniture and storage in place</li>
                <li>Tweak until it feels natural for how you move, sit, cook and rest</li>
                <li>Ensure systems are realistic for your energy and habits</li>
              </ul>
            </div>
        </div>
      </div>

      <p class="how-it-works__ending">Two sessions mean you get a clear beginning and end: <strong>a focused process, a finished space, and no endless back-and-forth.</strong></p>

      <div class="how-it-works__cta card">
        <p><strong>Ready to start?</strong> Fill in the enquiry form and I'll take it from there.</p>
        <a class="button button--primary" href="#ready" target="_blank" rel="noreferrer">Fill in the enquiry form</a>
      </div>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    background: var(--section-bg, var(--bg));
    border-top: 1px solid var(--section-border, rgba(199, 148, 92, 0.4));
    padding: 2.5rem 0 3rem;
  }

  .how-it-works__intro h2 {
    margin: 0;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    color: var(--section-heading, var(--heading));
    font-family: var(--font-heading);
  }

  .how-it-works__intro .subheading {
    margin: 0.5rem 0 0;
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--section-text, var(--text));
    font-weight: 400;
    max-width: 60ch;
  }

  .intro {
    max-width: 36rem;
    margin-top: 0.75rem;
  }

  .steps-wrapper {
    position: relative;
    margin-top: 2rem;
  }

  .steps {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    overflow-x: visible;
    padding-bottom: 0.25rem;
    position: relative;
    z-index: 1;
  }

  .step {
    min-width: 200px;
    flex: 0 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step__circle {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: #1e293b;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
    border: none;
    flex-shrink: 0;
  }

  .step__circle-text {
    font-size: 2rem;
    font-weight: 600;
    color: #f5f0e8;
    line-height: 1.3;
    padding: 1rem;
    font-family: var(--font-body);
  }

  .step__toggle {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: center;
    width: 100%;
  }

  .step__toggle h3 {
    margin: 0 0 0.5rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--section-heading, var(--heading));
    text-align: left;
  }

  .step__content {
    text-align: left;
  }

  .step p {
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .step ul {
    margin: 0.55rem 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.45rem;
  }

  .step li {
    font-size: 0.9rem;
  }

  @media (min-width: 720px) {
    .steps { justify-content: space-between; }
    .step { min-width: 0; flex: 1 1 0; }
    
    .step__toggle {
      pointer-events: none;
      cursor: default;
    }

    .step__content {
      display: block;
    }
  }

  @media (max-width: 719px) {
    .steps-wrapper {
      margin-top: 1rem;
    }

    .steps {
      flex-direction: column;
      gap: 1.5rem;
      align-items: stretch;
    }

    .step {
      min-width: auto;
      text-align: center;
      align-items: center;
    }

    .step__circle {
      width: 120px;
      height: 120px;
      margin: 0 auto 1rem;
    }

    .step__circle-text {
      font-size: 1.7rem;
      padding: 0.75rem;
    }

    .step__toggle {
      display: flex;
      align-items: center;
      width: 100%;
      text-align: left;
    }

    .step__toggle h3 {
      margin: 0;
      text-align: left;
    }

    .step__toggle::after {
      content: "▼";
      margin-left: auto;
      transition: transform 200ms ease;
      flex-shrink: 0;
    }

    .step__toggle[aria-expanded="true"]::after {
      transform: rotate(-180deg);
    }

    .step__content {
      display: none;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--section-border, rgba(199, 148, 92, 0.2));
    }

    .step__content.open {
      display: block;
    }
  }

  .how-it-works__intro h2,
  .how-it-works__ending,
  .how-it-works__cta p {
    color: var(--section-heading, var(--heading));
  }

  .how-it-works__ending {
    margin-top: 2rem;
    font-weight: 500;
  }

  .how-it-works__cta {
    margin-top: 2rem;
    border: 1px solid var(--section-border-2, rgba(59, 124, 130, 0.35));
    background: var(--section-surface, rgba(255, 250, 244, 0.78));
    display: flex;
    align-items: center;
    gap: 2rem;
    justify-content: space-between;
  }

  .how-it-works__cta p {
    margin: 0;
    flex: 1;
  }

  .how-it-works__cta .button {
    flex-shrink: 0;
  }

  @media (max-width: 719px) {
    .how-it-works__cta {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
    }

    .how-it-works__cta .button {
      width: 100%;
    }
  }
</style>

<script>
  // Mobile toggle functionality with accordion behavior
  const toggles = document.querySelectorAll('.step__toggle');
  
  toggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      const isMobile = window.innerWidth < 720;
      if (!isMobile) return;
      
      e.preventDefault();
      const step = toggle.closest('.step');
      const content = step.querySelector('.step__content');
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      
      // Close all other open items (accordion behavior)
      if (!isOpen) {
        toggles.forEach(otherToggle => {
          if (otherToggle !== toggle) {
            otherToggle.setAttribute('aria-expanded', 'false');
            otherToggle.closest('.step').querySelector('.step__content').classList.remove('open');
          }
        });
      }
      
      // Toggle current item
      toggle.setAttribute('aria-expanded', !isOpen);
      content.classList.toggle('open');
    });
  });

  // Handle window resize to reset toggles on desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 720) {
      toggles.forEach(toggle => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.closest('.step').querySelector('.step__content').classList.remove('open');
      });
    }
  });
</script>


