---
import Layout from "../layouts/Layout.astro";
---

<Layout
	pageTitle="Blog | Interior Design Studio"
	pageDescription="A preview page for future studio notes, design tips, and project updates."
>
	<section class="page-card card">
		<span class="pill">Blog</span>
		<h1>Ideas, updates, and design notes will appear here.</h1>
		<p>
			Use this page for studio updates, sourcing ideas, renovation advice, and short articles that help
			clients understand your process.
		</p>
		<div class="button-row">
			<a class="button button--primary" href="/">Back to home</a>
			<a class="button button--secondary" href="/projects">See projects</a>
		</div>
	</section>
</Layout>

<style>
	.page-card {
		margin-top: 3rem;
		margin-bottom: 3rem;
		padding: 2rem;
		display: grid;
		gap: 1rem;
	}

	h1 {
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		max-width: 10ch;
	}

	p {
		max-width: 58ch;
		font-size: 1.05rem;
		color: rgba(31, 41, 51, 0.82);
	}
</style>